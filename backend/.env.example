# VPMA Backend — Environment Variables
# Copy this file to .env and fill in your values.
# The server will run in SIMULATION mode without these — no real SMS will send.

# ── Twilio SMS (required for live SMS) ─────────────────────────────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567     # Your Twilio phone number in E.164 format

# Optional override: set to "false" to force simulation even with valid credentials
# SMS_ENABLED=true

# ── Future: SendGrid (email) ────────────────────────────────────────────────
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@vpma.app

# ── Future: Database ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/vpma

# ── Identity & RBAC (C7 — vendored cos_identity) ────────────────────────────
# Staff/owner-side auth. Provider is "fake" for dev/sim (Firebase deferred).
# The app boots with the dev defaults below; override any of these via env.
# Schema/role names MUST match the DDL apply values (see backend/identity/VENDORED.md).
#
# COS_IDENTITY_JWT_SECRET=change-me-in-shared-envs   # HS256 signing key (dev fallback exists)
# COS_IDENTITY_PROVIDER=fake                          # fake | firebase (firebase not wired)
# COS_IDENTITY_SEED_SUPERUSER_EMAIL=demo@clinic.com   # bootstrap superuser on first sign-in
# COS_IDENTITY_TOKEN_ISSUER=vetagent-identity
# COS_IDENTITY_APP_BASE_URL=http://localhost:3000
# COS_IDENTITY_ACCESS_TOKEN_TTL_MINUTES=1440
# COS_IDENTITY_REFRESH_TOKEN_TTL_DAYS=7
# COS_IDENTITY_SCHEMA_NAME=cos_identity
# COS_IDENTITY_APP_ROLE=cos_identity_app
# COS_IDENTITY_AUTH_ROLE=cos_identity_auth
# COS_IDENTITY_OWNER_ROLE=cos_identity_owner
# asyncpg DSN for the shared dev Postgres (host port 5433); falls back to VOICE_DATABASE_URL.
# COS_IDENTITY_DATABASE_URL=postgresql://voice:voice@localhost:5433/voice
# Break-glass escape hatch (secret env-only; never committed):
# COS_IDENTITY_ESCAPE_HATCH_SECRET=
